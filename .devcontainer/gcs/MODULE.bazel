"""The devcontainer's prebuilt GCS SDK: google-cloud-cpp and what it links, from the
Bazel Central Registry. Built once per image by .devcontainer/scripts/build-gcs-sdk.sh."""

module(name = "model_streamer_gcs_sdk")

# Linked into libstreamergcs, with everything it depends on (grpc, abseil, BoringSSL, ...)
# and the code they vendor.
# attribution: shipped module=py/runai_model_streamer_gcs,cpp vendored
bazel_dep(name = "google_cloud_cpp", version = "3.7.0")
bazel_dep(name = "rules_cc", version = "0.2.17")

# The ABI compatibility header shared with the application build (cpp/MODULE.bazel).
bazel_dep(name = "gcs_sdk_config")
local_path_override(module_name = "gcs_sdk_config", path = "config")

# grpc 1.81's envoy_api (0.0.0-20251216) imports googleapis' switched_rules extension, which the
# googleapis google_cloud_cpp 3.7.0 requires no longer has; the next envoy_api uses its replacement.
single_version_override(module_name = "envoy_api", version = "0.0.0-20260130-84e8436")
