"""The application build. The GCS SDK is not built here: the devcontainer prebuilds it
(.devcontainer/gcs) and google_cloud_cpp below is that prebuilt copy, checked against
this checkout's SDK build inputs."""

module(name = "runai_model_streamer")

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "googletest", version = "1.16.0", dev_dependency = True, repo_name = "com_google_googletest")

# The I/O engines' libraries, built from source by Bazel and linked statically into libstreamer.so
# (third_party/BUILD has the targets, and the system-library alternative for packagers).
# attribution: shipped module=py/runai_model_streamer,cpp
bazel_dep(name = "liburing", version = "2.14.bcr.2")
# attribution: shipped module=py/runai_model_streamer,cpp
bazel_dep(name = "libaio", version = "0.3.113.bcr.1")

# liburing's registry build runs its configure with --use-libc, as the devcontainer build did; the
# patch keeps the stack protector that build had (see the patch).
single_version_override(
    module_name = "liburing",
    patch_strip = 1,
    patches = ["//third_party:liburing_stack_protector.patch"],
)

# libaio's registry source URL (releases.pagure.org) is gone; bazel_downloader.cfg fetches the same
# archive, still checked against the registry's sha256, from Debian's mirror.

# The SDK's ABI compatibility header and build inputs, shared with the SDK builder.
bazel_dep(name = "gcs_sdk_config")
local_path_override(module_name = "gcs_sdk_config", path = "../.devcontainer/gcs/config")

# The native GCC toolchain, configured from the host (devcontainer).
cc_autoconf_toolchain = use_repo_rule("//toolchain:configure.bzl", "cc_autoconf_toolchain")

cc_autoconf_toolchain(name = "toolchain")

register_toolchains("@toolchain//:all")

# Starlark regression tests for prebuilt SDK validation.
register_toolchains("@bazel_skylib//toolchains/unittest:bash_toolchain")

# Libraries the devcontainer installs.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "cuda",
    build_file = "//third_party:cuda.BUILD",
    path = "/usr/local/cuda",
)

new_local_repository(
    name = "aws",
    build_file = "//third_party:aws.BUILD",
    path = "/opt",
)

new_local_repository(
    name = "azure",
    build_file = "//third_party:azure.BUILD",
    path = "/opt",
)

# The devcontainer prebuilds the SDK for its installed architectures.
# Application builds only compile our GCS adapter and tests.
prebuilt_gcp = use_repo_rule("//third_party:gcp_repo.bzl", "prebuilt_gcp")

prebuilt_gcp(name = "google_cloud_cpp")
