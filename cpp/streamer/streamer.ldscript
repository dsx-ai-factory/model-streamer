# The symbols this library exports. Used by libstreamer.so and by libstreamer-mock.so.
#
# The two names below are ELF version nodes, not product versions. A version node is a label on an
# exported symbol. The dynamic linker uses it to tell apart two incompatible versions of one symbol.
#
# LIBAIO_0.4
#   Required because we link libaio statically, and libaio defines io_getevents as
#   io_getevents@@LIBAIO_0.4 (libaio/src/syscall.h, DEFSYMVER). Without this node, ld fails with:
#
#       version node not found for symbol io_getevents@@LIBAIO_0.4
#
#   `local: *` and -Wl,--exclude-libs do not help; we tested both. The node must exist. It is empty
#   and marks everything local, so no libaio symbol is exported. libstreamer-mock.so does not link
#   libaio, so it does not use this node.
#
# RUNAI_FILE_STREAMER_1.0
#   Our node. It needs a name because ld does not allow an anonymous tag next to a named one. Our
#   symbols become runai_file_streamer_start@@RUNAI_FILE_STREAMER_1.0 instead of plain runai_file_streamer_start.
#
#   Nothing depends on the name today: we load the library with dlopen, Python uses ctypes.CDLL, and
#   dlsym ignores symbol versions. This changes when we ship streamer.h and libstreamer.so for other
#   programs to link against. Such a program records runai_file_streamer_start@RUNAI_FILE_STREAMER_1.0 in its own
#   binary, and the name becomes a contract - rename or remove it and those programs stop loading.
#   The name is still free to change until the first tarball goes out.
#
# The number is the ABI generation, not the release version. Do not raise it for a new release.
#
# Without version nodes, a program built against a newer streamer.h and run against an older
# libstreamer.so binds any symbol with a matching name and then fails in unclear ways. The node
# turns that into a clear load error.
#
# Add nodes; never rename or remove them:
#
#   new exported symbol   Add a node such as RUNAI_FILE_STREAMER_1.1 with only the new symbols. Old
#                         programs keep using their own node.
#
#   incompatible change   Add RUNAI_FILE_STREAMER_2.0 next to this one and keep the old implementation
#   to an existing        under the old node, as glibc does with memcpy@GLIBC_2.2.5 and
#   symbol                memcpy@@GLIBC_2.14. Only the @@ node is the default, so new programs link
#                         against the new symbol and old ones keep the old symbol.
#
# The object-storage plugins are a separate contract: s3.ldscript, gcs.ldscript and azure.ldscript
# use anonymous scripts, export only obj_*, and do not link libaio.
LIBAIO_0.4 { local: *; };

RUNAI_FILE_STREAMER_1.0 {
    global:
        runai_file_streamer_start;
        runai_file_streamer_end;
        runai_file_streamer_set_credentials;
        runai_file_streamer_set_fs_strategy;
        runai_file_streamer_request;
        runai_file_streamer_response;
        runai_file_streamer_response_str;
        runai_file_streamer_probe_direct_block_size;
        runai_file_streamer_list_files;
    local: *;
};
